{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Belegwerk",
  "version": "../package.json",
  "identifier": "de.belegwerk.desktop",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Belegwerk",
        "theme": "Light",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; base-uri 'self'; form-action 'self'"
    }
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Belegwerk",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
