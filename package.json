{
  "name": "belegwerk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "pnpm i18n:compile && tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --silent",
    "tauri": "tauri",
    "db:generate": "drizzle-kit generate",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
